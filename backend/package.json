{
  "name": "@agent-swarm/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:generate && bun run db:deploy && bun --watch src/index.ts",
    "start": "bun run db:deploy && bun src/index.ts",
    "typecheck": "bun run db:generate && tsc --noEmit",
    "openapi": "bun run db:generate && bun scripts/openapi.ts",
    "db:generate": "bun node_modules/prisma/build/index.js generate",
    "db:deploy": "bun scripts/migrate.ts"
  },
  "dependencies": {
    "@discordjs/core": "2.6.0",
    "@discordjs/rest": "2.6.3",
    "@discordjs/ws": "2.0.4",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/websocket": "11.3.1",
    "@libsql/client": "0.17.0",
    "@napi-rs/canvas": "^1.0.9",
    "@prisma/adapter-libsql": "7.9.1",
    "@prisma/client": "7.9.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sinclair/typebox": "^0.34.41",
    "discord-api-types": "0.38.56",
    "emojibase-data": "17.0.0",
    "fastify": "^5.6.2",
    "pdfjs-dist": "^6.3.289",
    "pi-web-access": "0.30.0",
    "prisma": "7.9.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "ws": "8"
  }
}
