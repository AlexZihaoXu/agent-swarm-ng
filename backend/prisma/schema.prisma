generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "sqlite"
}

enum ThinkingLevel {
  off
  minimal
  low
  medium
  high
  xhigh
  max
}

enum MessageRole {
  user
  assistant
}

// A computer is a platform resource, not an agent or a chat channel.
// Docker labels/volumes carry the same ID for recovery and ownership checks.
/// An organization: a folder of agents, computers and group chats that are kept apart from other organizations'
/// (assignments, DM permissions and group membership never cross it). Moving something drops its cross-org links.
model Organization {
  sequence  Int         @id @default(autoincrement())
  id        String      @unique @default(uuid())
  name      String
  createdAt DateTime    @default(now())
  agents    Agent[]
  computers Computer[]
  groups    GroupChat[]
}

model Computer {
  sequence   Int      @id @default(autoincrement())
  id         String   @unique @default(uuid())
  name       String
  requestKey String   @unique
  state      String   @default("creating")
  desiredState String @default("running")
  // Null denotes a pre-settings computer: infer effective values from Docker,
  // never fabricate a requested policy for an existing owner workspace.
  cpuCores   Int?
  memoryGiB  Int?
  timezone   String?
  // Where its Keep and Cache folders live (host folders chosen in Settings when it was created; null = its own
  // Docker volumes), and the paths it keeps beyond the home folder (JSON array of absolute paths).
  keepFolder  String?
  cacheFolder String?
  keptPaths   String   @default("[\"/home/agent\",\"/usr/local\"]")
  organizationId String @default("personal")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  assignments ComputerAssignment[]
  claim       ComputerClaim?
}

model ComputerAssignment {
  agentId String
  computerId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  computer Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
  @@id([agentId, computerId])
  @@index([computerId])
}

// Durable only to recover/release a claim after backend restart. Not an assignment.
model ComputerClaim {
  computerId String @id
  agentId String @unique
  token String @unique @default(uuid())
  claimedAt DateTime @default(now())
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  computer Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
}

model ComputerNotice {
  id String @id @default(uuid())
  agentId String
  text String
  createdAt DateTime @default(now())
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@index([agentId, createdAt])
}

model Agent {
  sequence         Int               @id @default(autoincrement())
  id               String            @unique @default(uuid())
  name             String
  avatar           String?
  endpointId       String
  model            String
  thinkingLevel    ThinkingLevel
  /// Background compaction during work starts at this share of the context window (percent).
  compactAtPercent   Int             @default(65)
  /// After this many idle minutes (0 = never), compact if the context is at least idleCompactPercent full.
  idleCompactMinutes Int             @default(30)
  idleCompactPercent Int             @default(50)
  /// The owner's own instructions for this agent, appended to its system prompt (Markdown).
  instructions       String          @default("")
  /// Heartbeat: a periodic wake-up that reads freely and is dropped unless it changes something.
  heartbeatEnabled   Boolean         @default(false)
  heartbeatMinutes   Int             @default(30)
  /// Active hours in the server's time zone ("HH:MM"); both empty means all day.
  heartbeatFrom      String          @default("")
  heartbeatTo        String          @default("")
  /// What the owner wants checked on each heartbeat (plain text).
  heartbeatChecklist String          @default("")
  organizationId     String          @default("personal")
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Long-term memory: the index (one line per memory) shown in its system prompt, rebuilt when it sleeps.
  memoryIndex        String          @default("")
  /// Sleep (memory reorganising) runs outside its active hours, or in this window when it is active all day.
  sleepFrom          String          @default("03:00")
  sleepTo            String          @default("05:00")
  sleptAt            DateTime?
  /// The saved-session archive position its last sleep covered (the next sleep starts there).
  sleptPosition      Int             @default(0)
  /// What the last sleep changed, told to the agent once at its next turn ("last night").
  sleepNote          String          @default("")
  sleepNoteTold      Boolean         @default(false)
  createdAt        DateTime          @default(now())
  channels         Channel[]
  dmAllowed        DmGrant[]         @relation("DmSenderGrant")
  dmAllowedBy      DmGrant[]         @relation("DmRecipientGrant")
  dmSent           DmMessage[]       @relation("DmSender")
  dmReceived       DmMessage[]       @relation("DmRecipient")
  dmChains         DmChain[]
  groupMemberships GroupMember[]
  reactions        MessageReaction[]
  recentEmojis     AgentEmojiRecent[]
  privateSession   AgentSession?
  computerAssignments ComputerAssignment[]
  computerClaim ComputerClaim?
  computerNotices ComputerNotice[]
  timers           AgentTimer[]
  watches          ComputerWatch[]
  scratchFiles     ScratchFile[]
  recordings       AgentRecording[]
  discordBot       DiscordBot?
  discordChannels  DiscordChannel[]
  discordMessages  DiscordMessage[]
  activity         Activity[]
  discordDmAllows  DiscordDmAllow[]
  memories         AgentMemory[]
}

/// One long-term memory of an agent (memorize). Forgetting sets deletedAt (restorable); every earlier text is a
/// version. Provenance: who caused it (by), how far that source is trusted, and where.
model AgentMemory {
  id             String    @id @default(uuid())
  agentId        String
  name           String
  type           String
  title          String
  text           String
  by             String
  trust          String
  channelId      String?
  recalls        Int       @default(0)
  lastRecalledAt DateTime?
  /// Faded by sleep: out of the index, still recallable.
  faded          Boolean   @default(false)
  /// Sleep found it contradicts another memory it could not settle: ask when relevant.
  conflict       Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  versions       AgentMemoryVersion[]

  @@unique([agentId, name])
  @@index([agentId, updatedAt])
}

/// A superseded version of a memory (its text before a change), and who changed it.
model AgentMemoryVersion {
  id        String      @id @default(uuid())
  memoryId  String
  title     String
  text      String
  type      String
  changedBy String
  createdAt DateTime    @default(now())
  memory    AgentMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId, createdAt])
}

// A one-shot watch on a claimed computer. Checks run in memory; the row only lets a restart (which releases claims
// and so ends watches) tell the agent its watch is gone.
/// An agent recording in progress (start_recording): kept so a restart can stop and save it and tell the agent.
model AgentRecording {
  id         String   @id
  agentId    String
  computerId String
  label      String
  folder     String
  createdAt  DateTime @default(now())
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model ComputerWatch {
  id         String   @id @default(uuid())
  agentId    String
  computerId String
  kind       String
  until      String
  human      Boolean  @default(false)
  createdAt  DateTime @default(now())
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@index([agentId])
}

// An agent's own timer (fires once) or repeating reminder. Firing wakes the agent with a platform event.
model AgentTimer {
  id          String    @id @default(uuid())
  agentId     String
  kind        String
  note        String    @default("")
  nextAt      DateTime
  intervalMs  Int?
  // How many times it fires in all; null repeats until cancelled.
  total       Int?
  fired       Int       @default(0)
  lastFiredAt DateTime?
  // Whether the run that set it could answer the human; the event carries the same authority.
  human       Boolean   @default(false)
  createdAt   DateTime  @default(now())
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@index([nextAt])
  @@index([agentId])
}

// Operator-visible traces only; never agent working context or channel publications.
model Activity {
  sequence  Int    @id @default(autoincrement())
  id        String @unique
  agentId   String
  runId     String
  channelId String
  kind      String
  label     String
  text      String
  timestamp Float
  revision  Int
  // Only the run-status entry has lifecycle state; startup interrupts active rows.
  state     String?
  agent     Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, sequence])
  @@index([agentId, label, sequence])
  @@index([state])
}

model DmGrant {
  senderId    String
  recipientId String
  sender      Agent  @relation("DmSenderGrant", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   Agent  @relation("DmRecipientGrant", fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([senderId, recipientId])
  @@index([recipientId])
}

model DmChain {
  id            String         @id
  rootAgentId   String?
  origin        String         @default("agent")
  rootGroupId   String?
  rootGroup     GroupChat?     @relation(fields: [rootGroupId], references: [id], onDelete: SetNull)
  rootAgent     Agent?         @relation(fields: [rootAgentId], references: [id], onDelete: SetNull)
  remaining     Int            @default(8)
  cancelled     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  messages      DmMessage[]
  groupMessages GroupMessage[]

  @@index([rootAgentId])
  @@index([rootGroupId])
}

model DmMessage {
  sequence       Int      @id @default(autoincrement())
  id             String   @unique @default(uuid())
  conversationId String
  senderId       String
  recipientId    String
  sender         Agent    @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      Agent    @relation("DmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  text           String
  replyToId      String?
  replyTo        DmMessage?  @relation("DmReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        DmMessage[] @relation("DmReplies")
  chainId        String
  chain          DmChain  @relation(fields: [chainId], references: [id], onDelete: Restrict)
  deliveryKey    String   @unique
  status         String   @default("queued")
  createdAt      DateTime @default(now())

  @@index([conversationId, sequence])
  @@index([recipientId, status, sequence])
  @@index([recipientId, sequence])
  @@index([status, sequence])
  @@index([senderId])
  @@index([chainId])
  @@index([replyToId])
}

model GroupChat {
  sequence  Int            @id @default(autoincrement())
  id        String         @unique @default(uuid())
  name      String
  organizationId String @default("personal")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())
  members   GroupMember[]
  messages  GroupMessage[]
  chains    DmChain[]
}

model GroupMember {
  groupId    String
  agentId    String
  group      GroupChat       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  agent      Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deliveries GroupDelivery[]

  @@id([groupId, agentId])
  @@index([agentId, groupId])
}

model GroupMessage {
  sequence      Int               @id @default(autoincrement())
  id            String            @unique @default(uuid())
  groupId       String
  group         GroupChat         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role          MessageRole
  // Immutable author snapshots keep shared history meaningful after agent deletion.
  authorId      String?
  authorName    String
  authorAvatar  String?
  text          String
  replyToId     String?
  replyTo       GroupMessage?     @relation("GroupReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       GroupMessage[]    @relation("GroupReplies")
  chainId       String
  chain         DmChain           @relation(fields: [chainId], references: [id], onDelete: Restrict)
  submissionKey String            @unique
  createdAt     DateTime          @default(now())
  deliveries    GroupDelivery[]
  reactions     MessageReaction[]

  @@unique([id, groupId])
  @@index([groupId, sequence])
  @@index([authorId, sequence])
  @@index([chainId])
  @@index([replyToId])
}

model GroupDelivery {
  messageId String
  groupId   String
  agentId   String
  status    String       @default("queued")
  message   GroupMessage @relation(fields: [messageId, groupId], references: [id, groupId], onDelete: Cascade)
  member    GroupMember  @relation(fields: [groupId, agentId], references: [groupId, agentId], onDelete: Cascade)

  @@id([messageId, agentId])
  @@index([agentId, status])
  @@index([groupId, agentId])
  @@index([status])
}

model AgentEmojiRecent {
  agentId String
  emoji   String
  usedAt  DateTime @default(now())
  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, emoji])
  @@index([agentId, usedAt])
}

// Private Pi working history; never returned as platform chat or operator activity.
model AgentSession {
  agentId    String              @id
  sessionId  String
  header     String
  entryCount    Int                 @default(0)
  activeStart   Int                 @default(0)
  leafId        String?
  privateCursor Int                 @default(0)
  dmCursor      Int                 @default(0)
  groupCursor   Int                 @default(0)
  updatedAt     DateTime            @updatedAt
  agent      Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  entries    AgentSessionEntry[]
}

model AgentSessionEntry {
  agentId  String
  position Int
  entryId  String
  parentId String?
  payload  String
  session  AgentSession @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@id([agentId, position])
  @@unique([agentId, entryId])
}

model MessageReaction {
  id             String        @id @default(uuid())
  messageId      String?
  groupMessageId String?
  actorKey       String
  agentId        String?
  emoji          String
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  groupMessage   GroupMessage? @relation(fields: [groupMessageId], references: [id], onDelete: Cascade)
  agent          Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([messageId, actorKey, emoji])
  @@unique([groupMessageId, actorKey, emoji])
  @@index([agentId])
}

model Channel {
  id       String    @id @default(uuid())
  agentId  String
  kind     String    @default("platform-chat")
  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([agentId])
}

model Message {
  sequence  Int               @id @default(autoincrement())
  id        String            @unique @default(uuid())
  channelId String
  role      MessageRole
  text      String
  replyToId String?
  replyTo   Message?          @relation("ChannelReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("ChannelReplies")
  createdAt DateTime          @default(now())
  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]

  @@index([channelId, sequence])
  @@index([channelId, createdAt, sequence])
  @@index([replyToId])
}

// Operator-wide settings for the whole swarm (one row, id 1). Absent row = defaults.
model SwarmSettings {
  id                Int      @id @default(1)
  maxComputers      Int      @default(4)
  uploadMaxMb       Int      @default(100)
  scratchFileMaxKb  Int      @default(1024)
  scratchMaxFiles   Int      @default(500)
  scratchTotalMb    Int      @default(50)
  storageBudgetGb   Int      @default(10)
  /// Days saved Discord messages are kept (older ones are pruned hourly).
  discordHistoryDays Int     @default(30)
  recordingLeaseSeconds    Int @default(300)
  recordingReminderSeconds Int @default(150)
  recordingMaxMinutes      Int @default(30)
  recordingDesktopKbps     Int @default(1000)
  recordingDesktopFps      Int @default(30)
  recordingTerminalFps     Int @default(15)
  recordingPadBeforeMs     Int @default(500)
  recordingPadAfterMs      Int @default(500)
  memoryIndexMaxLines      Int @default(60)
  memoryIndexMaxChars      Int @default(4000)
  memoryMaxChars           Int @default(2000)
  memoryMaxCount           Int @default(1000)
  /// Host folders new computers keep their files in (Settings → Computers → Storage); null = Docker volumes.
  computerKeepFolder  String?
  computerCacheFolder String?
  updatedAt         DateTime @updatedAt
}

// An agent's scratchpad: private text files kept in the database, with folder paths (at most 3 folders deep).
// For drafting and presenting artifacts; not memory. Nothing is deleted automatically.
model ScratchFile {
  id        String   @id @default(uuid())
  agentId   String
  path      String
  content   String
  // An image (PNG, JPEG, WebP or GIF) keeps its bytes here, with content "" (text files have neither).
  data      Bytes?
  mime      String?
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@unique([agentId, path])
}

// File bytes, identified by their SHA-256 and stored once under .local/files/ however often they are posted.
// Removed when no ChannelFile refers to them. `storage` is 'local' now; 'external' (e.g. Discord) later.
model FileBlob {
  id        String        @id
  size      Int
  storage   String        @default("local")
  location  String?
  createdAt DateTime      @default(now())
  files     ChannelFile[]
}

// A file posted to a channel: `chat:<channelId>`, `dm:<agentA>:<agentB>` or `group:<groupId>` (Discord etc.
// later). Deleting keeps the row as a tombstone (name, who deleted it and when) and drops its bytes.
model ChannelFile {
  id            String    @id @default(uuid())
  channelKey    String
  messageKind   String?
  messageId     String?
  uploaderKind  String
  uploaderId    String?
  uploaderName  String
  name          String
  mime          String
  kind          String
  size          Int
  blobId        String?
  blob          FileBlob? @relation(fields: [blobId], references: [id], onDelete: SetNull)
  status        String    @default("available")
  deletedByKind String?
  deletedById   String?
  deletedByName String?
  deletedAt     DateTime?
  /// A live scratch preview (kind "scratch"): the presenting agent's scratch file, read when shown.
  scratchAgentId String?
  scratchPath    String?
  createdAt     DateTime  @default(now())

  @@index([channelKey, createdAt])
  @@index([messageKind, messageId])
  @@index([blobId])
}

/// An agent's own Discord bot (its token lives in .local/discord-bots.json, never here). Policies are the owner's.
model DiscordBot {
  agentId     String   @id
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Learned when the bot logs in.
  botUserId   String?
  botName     String?
  /// Default admission for allowed server channels: "mention" | "check" | "all".
  admission   String    @default("check")
  /// After an outage, deliver missed DMs and mentions as one labelled batch.
  catchUp     Boolean  @default(true)
  /// The status the agent chose: "auto" (online, idle after 10 min without write activity), "idle" or "dnd".
  presenceMode String  @default("auto")
  /// The bot's custom status text ("" for none).
  statusText  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A Discord channel as one agent's bot knows it: its allow-list entry and intake state.
model DiscordChannel {
  agentId       String
  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  channelId     String
  guildId       String?
  guildName     String?
  /// A thread's parent channel (threads follow their parent's allow-list unless set themselves).
  parentId      String?
  /// A DM's other person (whose role decides whether the DM may be used).
  recipientId   String?
  name          String
  /// "dm" | "text" | "thread" | "forum" | "announcement" | "voice"
  kind          String
  allowed       Boolean   @default(false)
  /// Overrides the bot's default admission for this channel.
  admission     String?
  /// The newest message a trigger announced to the agent ("unread" starts after it).
  announcedUpTo String?
  /// Consecutive turns here started only by bots (reset when a person speaks).
  botOnlyTurns  Int       @default(0)
  pausedAt      DateTime?
  updatedAt     DateTime  @updatedAt

  @@id([agentId, channelId])
}

/// Who a Discord account is to the swarm: the owner (human authority) or one of our agents' bots.
model DiscordAccount {
  discordUserId String   @id
  role          String
  agentId       String?
  name          String
  createdAt     DateTime @default(now())
}

/// Messages an agent's bot saw in its allowed channels and DMs (for the inbox, DM search and chains).
model DiscordMessage {
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  id          String
  channelId   String
  guildId     String?
  authorId    String
  authorName  String
  authorBot   Boolean   @default(false)
  content     String
  /// Our agents' publications carry their communication chain, so other agents inherit its budget.
  chainId     String?
  replyToId   String?
  mentionsBot Boolean   @default(false)
  attachments String?
  createdAt   DateTime
  editedAt    DateTime?
  deletedAt   DateTime?

  @@id([agentId, id])
  @@index([agentId, channelId, createdAt])
  @@index([createdAt])
}

// Who may DM an agent's Discord bot besides the owner's accounts and our agents' bots (a whitelist; nobody else).
model DiscordDmAllow {
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  discordUserId String
  /// A label for the owner (Discord name when added).
  name          String
  createdAt     DateTime @default(now())

  @@id([agentId, discordUserId])
}

