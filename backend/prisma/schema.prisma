generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "sqlite"
}

enum ThinkingLevel {
  off
  minimal
  low
  medium
  high
  xhigh
  max
}

enum MessageRole {
  user
  assistant
}

// A computer is a platform resource, not an agent or a chat channel.
// Docker labels/volumes carry the same ID for recovery and ownership checks.
model Computer {
  sequence   Int      @id @default(autoincrement())
  id         String   @unique @default(uuid())
  name       String
  requestKey String   @unique
  state      String   @default("creating")
  desiredState String @default("running")
  // Null denotes a pre-settings computer: infer effective values from Docker,
  // never fabricate a requested policy for an existing owner workspace.
  cpuCores   Int?
  memoryGiB  Int?
  timezone   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  assignments ComputerAssignment[]
  claim       ComputerClaim?
}

model ComputerAssignment {
  agentId String
  computerId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  computer Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
  @@id([agentId, computerId])
  @@index([computerId])
}

// Durable only to recover/release a claim after backend restart. Not an assignment.
model ComputerClaim {
  computerId String @id
  agentId String @unique
  token String @unique @default(uuid())
  claimedAt DateTime @default(now())
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  computer Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
}

model ComputerNotice {
  id String @id @default(uuid())
  agentId String
  text String
  createdAt DateTime @default(now())
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@index([agentId, createdAt])
}

model Agent {
  sequence         Int               @id @default(autoincrement())
  id               String            @unique @default(uuid())
  name             String
  avatar           String?
  endpointId       String
  model            String
  thinkingLevel    ThinkingLevel
  createdAt        DateTime          @default(now())
  channels         Channel[]
  dmAllowed        DmGrant[]         @relation("DmSenderGrant")
  dmAllowedBy      DmGrant[]         @relation("DmRecipientGrant")
  dmSent           DmMessage[]       @relation("DmSender")
  dmReceived       DmMessage[]       @relation("DmRecipient")
  dmChains         DmChain[]
  groupMemberships GroupMember[]
  reactions        MessageReaction[]
  recentEmojis     AgentEmojiRecent[]
  privateSession   AgentSession?
  computerAssignments ComputerAssignment[]
  computerClaim ComputerClaim?
  computerNotices ComputerNotice[]
  activity         Activity[]
}

// Operator-visible traces only; never agent working context or channel publications.
model Activity {
  sequence  Int    @id @default(autoincrement())
  id        String @unique
  agentId   String
  runId     String
  channelId String
  kind      String
  label     String
  text      String
  timestamp Float
  revision  Int
  // Only the run-status entry has lifecycle state; startup interrupts active rows.
  state     String?
  agent     Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, sequence])
  @@index([agentId, label, sequence])
  @@index([state])
}

model DmGrant {
  senderId    String
  recipientId String
  sender      Agent  @relation("DmSenderGrant", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   Agent  @relation("DmRecipientGrant", fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([senderId, recipientId])
  @@index([recipientId])
}

model DmChain {
  id            String         @id
  rootAgentId   String?
  origin        String         @default("agent")
  rootGroupId   String?
  rootGroup     GroupChat?     @relation(fields: [rootGroupId], references: [id], onDelete: SetNull)
  rootAgent     Agent?         @relation(fields: [rootAgentId], references: [id], onDelete: SetNull)
  remaining     Int            @default(8)
  cancelled     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  messages      DmMessage[]
  groupMessages GroupMessage[]

  @@index([rootAgentId])
  @@index([rootGroupId])
}

model DmMessage {
  sequence       Int      @id @default(autoincrement())
  id             String   @unique @default(uuid())
  conversationId String
  senderId       String
  recipientId    String
  sender         Agent    @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      Agent    @relation("DmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  text           String
  replyToId      String?
  replyTo        DmMessage?  @relation("DmReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        DmMessage[] @relation("DmReplies")
  chainId        String
  chain          DmChain  @relation(fields: [chainId], references: [id], onDelete: Restrict)
  deliveryKey    String   @unique
  status         String   @default("queued")
  createdAt      DateTime @default(now())

  @@index([conversationId, sequence])
  @@index([recipientId, status, sequence])
  @@index([recipientId, sequence])
  @@index([status, sequence])
  @@index([senderId])
  @@index([chainId])
  @@index([replyToId])
}

model GroupChat {
  sequence  Int            @id @default(autoincrement())
  id        String         @unique @default(uuid())
  name      String
  createdAt DateTime       @default(now())
  members   GroupMember[]
  messages  GroupMessage[]
  chains    DmChain[]
}

model GroupMember {
  groupId    String
  agentId    String
  group      GroupChat       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  agent      Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deliveries GroupDelivery[]

  @@id([groupId, agentId])
  @@index([agentId, groupId])
}

model GroupMessage {
  sequence      Int               @id @default(autoincrement())
  id            String            @unique @default(uuid())
  groupId       String
  group         GroupChat         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role          MessageRole
  // Immutable author snapshots keep shared history meaningful after agent deletion.
  authorId      String?
  authorName    String
  authorAvatar  String?
  text          String
  replyToId     String?
  replyTo       GroupMessage?     @relation("GroupReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       GroupMessage[]    @relation("GroupReplies")
  chainId       String
  chain         DmChain           @relation(fields: [chainId], references: [id], onDelete: Restrict)
  submissionKey String            @unique
  createdAt     DateTime          @default(now())
  deliveries    GroupDelivery[]
  reactions     MessageReaction[]

  @@unique([id, groupId])
  @@index([groupId, sequence])
  @@index([authorId, sequence])
  @@index([chainId])
  @@index([replyToId])
}

model GroupDelivery {
  messageId String
  groupId   String
  agentId   String
  status    String       @default("queued")
  message   GroupMessage @relation(fields: [messageId, groupId], references: [id, groupId], onDelete: Cascade)
  member    GroupMember  @relation(fields: [groupId, agentId], references: [groupId, agentId], onDelete: Cascade)

  @@id([messageId, agentId])
  @@index([agentId, status])
  @@index([groupId, agentId])
  @@index([status])
}

model AgentEmojiRecent {
  agentId String
  emoji   String
  usedAt  DateTime @default(now())
  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, emoji])
  @@index([agentId, usedAt])
}

// Private Pi working history; never returned as platform chat or operator activity.
model AgentSession {
  agentId    String              @id
  sessionId  String
  header     String
  entryCount    Int                 @default(0)
  activeStart   Int                 @default(0)
  leafId        String?
  privateCursor Int                 @default(0)
  dmCursor      Int                 @default(0)
  groupCursor   Int                 @default(0)
  updatedAt     DateTime            @updatedAt
  agent      Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  entries    AgentSessionEntry[]
}

model AgentSessionEntry {
  agentId  String
  position Int
  entryId  String
  parentId String?
  payload  String
  session  AgentSession @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@id([agentId, position])
  @@unique([agentId, entryId])
}

model MessageReaction {
  id             String        @id @default(uuid())
  messageId      String?
  groupMessageId String?
  actorKey       String
  agentId        String?
  emoji          String
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  groupMessage   GroupMessage? @relation(fields: [groupMessageId], references: [id], onDelete: Cascade)
  agent          Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([messageId, actorKey, emoji])
  @@unique([groupMessageId, actorKey, emoji])
  @@index([agentId])
}

model Channel {
  id       String    @id @default(uuid())
  agentId  String
  kind     String    @default("platform-chat")
  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([agentId])
}

model Message {
  sequence  Int               @id @default(autoincrement())
  id        String            @unique @default(uuid())
  channelId String
  role      MessageRole
  text      String
  replyToId String?
  replyTo   Message?          @relation("ChannelReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("ChannelReplies")
  createdAt DateTime          @default(now())
  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]

  @@index([channelId, sequence])
  @@index([channelId, createdAt, sequence])
  @@index([replyToId])
}
