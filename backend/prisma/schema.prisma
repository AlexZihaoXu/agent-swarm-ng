generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "sqlite"
}

enum ThinkingLevel {
  off
  minimal
  low
  medium
  high
  xhigh
  max
}

enum MessageRole {
  user
  assistant
}

// A computer is a platform resource, not an agent or a chat channel.
// Docker labels/volumes carry the same ID for recovery and ownership checks.
/// An organization: a folder of agents, computers and group chats that are kept apart from other organizations'
/// (assignments, DM permissions and group membership never cross it). Moving something drops its cross-org links.
model Organization {
  sequence  Int         @id @default(autoincrement())
  id        String      @unique @default(uuid())
  name      String
  /// Its owner (docs/users.md): the only user, besides admin, who reaches it; its agents use the owner's model
  /// connections. Deleting a user hands their organizations to admin first.
  ownerId   String      @default("admin")
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt DateTime    @default(now())
  agents    Agent[]
  computers Computer[]
  groups    GroupChat[]
}

model Computer {
  sequence       Int                  @id @default(autoincrement())
  id             String               @unique @default(uuid())
  name           String
  /// The name it was created with: its containers carry it as an immutable label, so the controller is always given
  /// this one; `name` can be renamed. Empty for none recorded (then `name`).
  labelName      String               @default("")
  requestKey     String               @unique
  state          String               @default("creating")
  desiredState   String               @default("running")
  // Null denotes a pre-settings computer: infer effective values from Docker,
  // never fabricate a requested policy for an existing owner workspace.
  cpuCores       Int?
  memoryGiB      Int?
  timezone       String?
  // Where its Keep and Cache folders live (host folders chosen in Settings when it was created; null = its own
  // Docker volumes), and the paths it keeps beyond the home folder (JSON array of absolute paths).
  keepFolder     String?
  cacheFolder    String?
  keptPaths      String               @default("[\"/home/agent\",\"/usr/local\"]")
  organizationId String               @default("personal")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  assignments    ComputerAssignment[]
  claim          ComputerClaim?
}

model ComputerAssignment {
  agentId    String
  computerId String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  computer   Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)

  @@id([agentId, computerId])
  @@index([computerId])
}

// Durable only to recover/release a claim after backend restart. Not an assignment.
model ComputerClaim {
  computerId String   @id
  agentId    String   @unique
  token      String   @unique @default(uuid())
  claimedAt  DateTime @default(now())
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  computer   Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
}

model ComputerNotice {
  id        String   @id @default(uuid())
  agentId   String
  text      String
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

model Agent {
  sequence            Int                  @id @default(autoincrement())
  id                  String               @unique @default(uuid())
  name                String
  avatar              String?
  endpointId          String
  model               String
  thinkingLevel       ThinkingLevel
  /// Fallback models (docs/agent-models.md): #1's options and the ranked fallbacks with theirs (JSON; model-chain.ts).
  modelChain          String               @default("{}")
  /// Background compaction during work starts at this share of the context window (percent).
  compactAtPercent    Int                  @default(65)
  /// After this many idle minutes (0 = never), compact if the context is at least idleCompactPercent full.
  idleCompactMinutes  Int                  @default(30)
  idleCompactPercent  Int                  @default(50)
  /// The owner's own instructions for this agent, appended to its system prompt (Markdown).
  instructions        String               @default("")
  /// Heartbeat: a periodic wake-up that reads freely and is dropped unless it changes something.
  heartbeatEnabled    Boolean              @default(false)
  heartbeatMinutes    Int                  @default(30)
  /// Active hours in the server's time zone ("HH:MM"); both empty means all day.
  heartbeatFrom       String               @default("")
  heartbeatTo         String               @default("")
  /// What the owner wants checked on each heartbeat (plain text).
  heartbeatChecklist  String               @default("")
  organizationId      String               @default("personal")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Its todo list (todo_write, JSON [{content, status}]): unfinished items make the platform check, when a turn
  /// ends, whether it should continue (docs/agent-todos.md).
  todos               String               @default("[]")
  /// Minutes per clock-aligned window in which a working agent gets one note of the current time (0: off;
  /// docs/agent-time.md#time-notes).
  timeNoteMinutes     Int                  @default(15)
  /// Long-term memory: the index (one line per memory) shown in its system prompt, rebuilt when it sleeps.
  memoryIndex         String               @default("")
  /// Sleep (memory reorganising) runs outside its active hours, or in this window when it is active all day.
  sleepFrom           String               @default("03:00")
  sleepTo             String               @default("05:00")
  sleptAt             DateTime?
  /// The saved-session archive position its last sleep covered (the next sleep starts there).
  sleptPosition       Int                  @default(0)
  /// What the last sleep changed, told to the agent once at its next turn ("last night").
  sleepNote           String               @default("")
  sleepNoteTold       Boolean              @default(false)
  createdAt           DateTime             @default(now())
  channels            Channel[]
  dmAllowed           DmGrant[]            @relation("DmSenderGrant")
  dmAllowedBy         DmGrant[]            @relation("DmRecipientGrant")
  dmSent              DmMessage[]          @relation("DmSender")
  dmReceived          DmMessage[]          @relation("DmRecipient")
  dmChains            DmChain[]
  groupMemberships    GroupMember[]
  reactions           MessageReaction[]
  recentEmojis        AgentEmojiRecent[]
  privateSession      AgentSession?
  computerAssignments ComputerAssignment[]
  computerClaim       ComputerClaim?
  computerNotices     ComputerNotice[]
  timers              AgentTimer[]
  pendingTimerEvents  PendingTimerEvent[]
  watches             ComputerWatch[]
  scratchFiles        ScratchFile[]
  recordings          AgentRecording[]
  discordBot          DiscordBot?
  discordChannels     DiscordChannel[]
  discordMessages     DiscordMessage[]
  activity            Activity[]
  discordDmAllows     DiscordDmAllow[]
  memories            AgentMemory[]
  avatarImage         AgentAvatarImage?
}

/// One long-term memory of an agent (memorize). Forgetting sets deletedAt (restorable); every earlier text is a
/// version. Provenance: who caused it (by), how far that source is trusted, and where.
model AgentMemory {
  id             String               @id @default(uuid())
  agentId        String
  name           String
  type           String
  title          String
  text           String
  by             String
  trust          String
  channelId      String?
  recalls        Int                  @default(0)
  lastRecalledAt DateTime?
  /// Faded by sleep: out of the index, still recallable.
  faded          Boolean              @default(false)
  /// Sleep found it contradicts another memory it could not settle: ask when relevant.
  conflict       Boolean              @default(false)
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  agent          Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  versions       AgentMemoryVersion[]

  @@unique([agentId, name])
  @@index([agentId, updatedAt])
}

/// A superseded version of a memory (its text before a change), and who changed it.
model AgentMemoryVersion {
  id        String      @id @default(uuid())
  memoryId  String
  title     String
  text      String
  type      String
  changedBy String
  createdAt DateTime    @default(now())
  memory    AgentMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId, createdAt])
}

// A one-shot watch on a claimed computer. Checks run in memory; the row only lets a restart (which releases claims
// and so ends watches) tell the agent its watch is gone.
/// An agent recording in progress (start_recording): kept so a restart can stop and save it and tell the agent.
model AgentRecording {
  id         String   @id
  agentId    String
  computerId String
  label      String
  folder     String
  createdAt  DateTime @default(now())
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model ComputerWatch {
  id         String   @id @default(uuid())
  agentId    String
  computerId String
  kind       String
  until      String
  human      Boolean  @default(false)
  createdAt  DateTime @default(now())
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

// An agent's own timer (fires once) or repeating reminder. Firing wakes the agent with a platform event.
/// A timer or reminder firing not yet seen by its agent: saved with the firing, removed once a turn processed it, and
/// delivered again (marked so) after a restart (agent-timers.ts).
model PendingTimerEvent {
  id        String   @id
  agentId   String
  kind      String
  text      String
  human     Boolean  @default(false)
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model AgentTimer {
  id          String    @id @default(uuid())
  agentId     String
  kind        String
  note        String    @default("")
  nextAt      DateTime
  intervalMs  Int?
  // How many times it fires in all; null repeats until cancelled.
  total       Int?
  fired       Int       @default(0)
  lastFiredAt DateTime?
  // Whether the run that set it could answer the human; the event carries the same authority.
  human       Boolean   @default(false)
  createdAt   DateTime  @default(now())
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([nextAt])
  @@index([agentId])
}

// Operator-visible traces only; never agent working context or channel publications.
model Activity {
  sequence  Int     @id @default(autoincrement())
  id        String  @unique
  agentId   String
  runId     String
  channelId String
  kind      String
  label     String
  text      String
  timestamp Float
  revision  Int
  // Only the run-status entry has lifecycle state; startup interrupts active rows.
  state     String?
  agent     Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, sequence])
  @@index([agentId, label, sequence])
  @@index([state])
}

model DmGrant {
  senderId    String
  recipientId String
  sender      Agent  @relation("DmSenderGrant", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   Agent  @relation("DmRecipientGrant", fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([senderId, recipientId])
  @@index([recipientId])
}

model DmChain {
  id            String         @id
  rootAgentId   String?
  origin        String         @default("agent")
  rootGroupId   String?
  rootGroup     GroupChat?     @relation(fields: [rootGroupId], references: [id], onDelete: SetNull)
  rootAgent     Agent?         @relation(fields: [rootAgentId], references: [id], onDelete: SetNull)
  remaining     Int            @default(8)
  cancelled     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  messages      DmMessage[]
  groupMessages GroupMessage[]

  @@index([rootAgentId])
  @@index([rootGroupId])
}

model DmMessage {
  sequence       Int         @id @default(autoincrement())
  id             String      @unique @default(uuid())
  conversationId String
  senderId       String
  recipientId    String
  sender         Agent       @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      Agent       @relation("DmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  text           String
  replyToId      String?
  replyTo        DmMessage?  @relation("DmReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        DmMessage[] @relation("DmReplies")
  chainId        String
  chain          DmChain     @relation(fields: [chainId], references: [id], onDelete: Restrict)
  deliveryKey    String      @unique
  status         String      @default("queued")
  createdAt      DateTime    @default(now())

  @@index([conversationId, sequence])
  @@index([recipientId, status, sequence])
  @@index([recipientId, sequence])
  @@index([status, sequence])
  @@index([senderId])
  @@index([chainId])
  @@index([replyToId])
  /// Message search by day across all chats (docs/chat-and-groups.md#search).
  @@index([createdAt])
}

model GroupChat {
  sequence       Int            @id @default(autoincrement())
  id             String         @unique @default(uuid())
  name           String
  organizationId String         @default("personal")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())
  members        GroupMember[]
  messages       GroupMessage[]
  chains         DmChain[]
}

model GroupMember {
  groupId    String
  agentId    String
  group      GroupChat       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  agent      Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deliveries GroupDelivery[]

  @@id([groupId, agentId])
  @@index([agentId, groupId])
}

model GroupMessage {
  sequence      Int               @id @default(autoincrement())
  id            String            @unique @default(uuid())
  groupId       String
  group         GroupChat         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role          MessageRole
  // Immutable author snapshots keep shared history meaningful after agent deletion.
  authorId      String?
  authorName    String
  authorAvatar  String?
  text          String
  replyToId     String?
  replyTo       GroupMessage?     @relation("GroupReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       GroupMessage[]    @relation("GroupReplies")
  chainId       String
  chain         DmChain           @relation(fields: [chainId], references: [id], onDelete: Restrict)
  submissionKey String            @unique
  createdAt     DateTime          @default(now())
  deliveries    GroupDelivery[]
  reactions     MessageReaction[]

  @@unique([id, groupId])
  @@index([groupId, sequence])
  @@index([authorId, sequence])
  @@index([chainId])
  @@index([replyToId])
  /// Message search by day across all chats (docs/chat-and-groups.md#search).
  @@index([createdAt])
}

model GroupDelivery {
  messageId String
  groupId   String
  agentId   String
  status    String       @default("queued")
  message   GroupMessage @relation(fields: [messageId, groupId], references: [id, groupId], onDelete: Cascade)
  member    GroupMember  @relation(fields: [groupId, agentId], references: [groupId, agentId], onDelete: Cascade)

  @@id([messageId, agentId])
  @@index([agentId, status])
  @@index([groupId, agentId])
  @@index([status])
}

model AgentEmojiRecent {
  agentId String
  emoji   String
  usedAt  DateTime @default(now())
  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, emoji])
  @@index([agentId, usedAt])
}

// Private Pi working history; never returned as platform chat or operator activity.
model AgentSession {
  agentId       String              @id
  sessionId     String
  header        String
  entryCount    Int                 @default(0)
  activeStart   Int                 @default(0)
  leafId        String?
  privateCursor Int                 @default(0)
  dmCursor      Int                 @default(0)
  groupCursor   Int                 @default(0)
  updatedAt     DateTime            @updatedAt
  agent         Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  entries       AgentSessionEntry[]
}

model AgentSessionEntry {
  agentId  String
  position Int
  entryId  String
  parentId String?
  payload  String
  session  AgentSession @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@id([agentId, position])
  @@unique([agentId, entryId])
}

model MessageReaction {
  id             String        @id @default(uuid())
  messageId      String?
  groupMessageId String?
  actorKey       String
  agentId        String?
  emoji          String
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  groupMessage   GroupMessage? @relation(fields: [groupMessageId], references: [id], onDelete: Cascade)
  agent          Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([messageId, actorKey, emoji])
  @@unique([groupMessageId, actorKey, emoji])
  @@index([agentId])
}

model Channel {
  id       String    @id @default(uuid())
  agentId  String
  kind     String    @default("platform-chat")
  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([agentId])
}

model Message {
  sequence     Int               @id @default(autoincrement())
  id           String            @unique @default(uuid())
  channelId    String
  role         MessageRole
  /// The person who wrote a human message (null: written before there were users, by the owner).
  authorUserId String?
  authorName   String?
  text         String
  replyToId    String?
  replyTo      Message?          @relation("ChannelReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("ChannelReplies")
  createdAt    DateTime          @default(now())
  channel      Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[]

  @@index([channelId, sequence])
  @@index([channelId, createdAt, sequence])
  @@index([replyToId])
  /// Message search by day across all chats (docs/chat-and-groups.md#search).
  @@index([createdAt])
}

// Operator-wide settings for the whole swarm (one row, id 1). Absent row = defaults.
model SwarmSettings {
  id                       Int      @id @default(1)
  maxComputers             Int      @default(4)
  uploadMaxMb              Int      @default(100)
  scratchFileMaxKb         Int      @default(1024)
  scratchMaxFiles          Int      @default(500)
  scratchTotalMb           Int      @default(50)
  storageBudgetGb          Int      @default(10)
  /// Days saved Discord messages are kept (older ones are pruned hourly).
  discordHistoryDays       Int      @default(30)
  recordingLeaseSeconds    Int      @default(300)
  recordingReminderSeconds Int      @default(150)
  recordingMaxMinutes      Int      @default(30)
  recordingDesktopKbps     Int      @default(1000)
  recordingDesktopFps      Int      @default(30)
  recordingTerminalFps     Int      @default(15)
  recordingPadBeforeMs     Int      @default(500)
  recordingPadAfterMs      Int      @default(500)
  memoryIndexMaxLines      Int      @default(60)
  memoryIndexMaxChars      Int      @default(4000)
  memoryMaxChars           Int      @default(2000)
  memoryMaxCount           Int      @default(1000)
  /// Failed sign-ins (from any address) within an hour that lock the dashboard down (0: never).
  lockdownFailures         Int      @default(20)
  /// Host folders new computers keep their files in (Settings → Computers → Storage); null = Docker volumes.
  computerKeepFolder       String?
  computerCacheFolder      String?
  updatedAt                DateTime @updatedAt
}

// An agent's scratchpad: private text files kept in the database, with folder paths (at most 3 folders deep).
// For drafting and presenting artifacts; not memory. Nothing is deleted automatically.
model ScratchFile {
  id        String   @id @default(uuid())
  agentId   String
  path      String
  content   String
  // An image (PNG, JPEG, WebP or GIF) keeps its bytes here, with content "" (text files have neither).
  data      Bytes?
  mime      String?
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, path])
}

// File bytes, identified by their SHA-256 and stored once under .local/files/ however often they are posted.
// Removed when no ChannelFile refers to them. `storage` is 'local' now; 'external' (e.g. Discord) later.
model FileBlob {
  id        String        @id
  size      Int
  storage   String        @default("local")
  location  String?
  createdAt DateTime      @default(now())
  files     ChannelFile[]
}

// A file posted to a channel: `chat:<channelId>`, `dm:<agentA>:<agentB>` or `group:<groupId>` (Discord etc.
// later). Deleting keeps the row as a tombstone (name, who deleted it and when) and drops its bytes.
model ChannelFile {
  id             String    @id @default(uuid())
  channelKey     String
  messageKind    String?
  messageId      String?
  uploaderKind   String
  uploaderId     String?
  uploaderName   String
  name           String
  mime           String
  kind           String
  size           Int
  blobId         String?
  blob           FileBlob? @relation(fields: [blobId], references: [id], onDelete: SetNull)
  status         String    @default("available")
  deletedByKind  String?
  deletedById    String?
  deletedByName  String?
  deletedAt      DateTime?
  /// A live scratch preview (kind "scratch"): the presenting agent's scratch file, read when shown.
  scratchAgentId String?
  scratchPath    String?
  createdAt      DateTime  @default(now())

  @@index([channelKey, createdAt])
  @@index([messageKind, messageId])
  @@index([blobId])
}

/// An agent's own Discord bot (its token lives in .local/discord-bots.json, never here). Policies are the owner's.
model DiscordBot {
  agentId      String   @id
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Learned when the bot logs in.
  botUserId    String?
  botName      String?
  /// Default admission for allowed server channels: "mention" | "check" | "all".
  admission    String   @default("check")
  /// After an outage, deliver missed DMs and mentions as one labelled batch.
  catchUp      Boolean  @default(true)
  /// The status the agent chose: "auto" (online, idle after 10 min without write activity), "idle" or "dnd".
  presenceMode String   @default("auto")
  /// The bot's custom status text ("" for none).
  statusText   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A Discord channel as one agent's bot knows it: its allow-list entry and intake state.
model DiscordChannel {
  agentId       String
  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  channelId     String
  guildId       String?
  guildName     String?
  /// A thread's parent channel (threads follow their parent's allow-list unless set themselves).
  parentId      String?
  /// A DM's other person (whose role decides whether the DM may be used).
  recipientId   String?
  name          String
  /// "dm" | "text" | "thread" | "forum" | "announcement" | "voice"
  kind          String
  allowed       Boolean   @default(false)
  /// Overrides the bot's default admission for this channel.
  admission     String?
  /// The newest message a trigger announced to the agent ("unread" starts after it).
  announcedUpTo String?
  /// Consecutive turns here started only by bots (reset when a person speaks).
  botOnlyTurns  Int       @default(0)
  pausedAt      DateTime?
  updatedAt     DateTime  @updatedAt

  @@id([agentId, channelId])
}

/// Who a Discord account is to the swarm: the owner (human authority) or one of our agents' bots.
model DiscordAccount {
  discordUserId String   @id
  role          String
  /// The person an owner account belongs to (docs/users.md): it carries authority over that person's agents.
  userId        String   @default("admin")
  agentId       String?
  name          String
  createdAt     DateTime @default(now())
}

/// Messages an agent's bot saw in its allowed channels and DMs (for the inbox, DM search and chains).
model DiscordMessage {
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  id          String
  channelId   String
  guildId     String?
  authorId    String
  authorName  String
  authorBot   Boolean   @default(false)
  content     String
  /// Our agents' publications carry their communication chain, so other agents inherit its budget.
  chainId     String?
  replyToId   String?
  mentionsBot Boolean   @default(false)
  attachments String?
  createdAt   DateTime
  editedAt    DateTime?
  deletedAt   DateTime?

  @@id([agentId, id])
  @@index([agentId, channelId, createdAt])
  @@index([createdAt])
}

// Who may DM an agent's Discord bot besides the owner's accounts and our agents' bots (a whitelist; nobody else).
model DiscordDmAllow {
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  discordUserId String
  /// A label for the owner (Discord name when added).
  name          String
  createdAt     DateTime @default(now())

  @@id([agentId, discordUserId])
}

/// A person who signs in to the dashboard (docs/users.md). The migration creates "Admin" (role admin) with no
/// password: the first sign-in sets it. Admin creates the users.
model User {
  sequence          Int                @id @default(autoincrement())
  id                String             @unique @default(uuid())
  name              String             @unique
  /// 'admin' (one, reaches everything) or 'user' (reaches only the organizations they own).
  role              String             @default("user")
  /// Disabled: refused at sign-in, signed out everywhere; their agents keep running.
  disabledAt        DateTime?
  /// The most RAM (GiB) the computers in their organizations may have in total; null: no cap.
  memoryLimitGiB    Int?
  /// Their IANA time zone (docs/users.md#time-zone): their agents tell and take times in it. "" until set.
  timeZone          String             @default("")
  organizations     Organization[]
  /// scrypt hash (auth/sessions.ts); null until the first sign-in sets it (or after a host-side reset).
  passwordHash      String?
  passwordChangedAt DateTime?
  createdAt         DateTime           @default(now())
  sessions          UserSession[]
  pushSubscriptions PushSubscription[]
  pushPreferences   PushPreferences?
}

/// A signed-in browser. Only the SHA-256 of the cookie's random token is stored.
model UserSession {
  tokenHash         String             @id
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  lastSeenAt        DateTime           @default(now())
  expiresAt         DateTime
  /// Devices subscribed for push from this browser session: signing out ends them too.
  pushSubscriptions PushSubscription[]

  @@index([userId])
  @@index([expiresAt])
}

/// The audit log (docs/audit-log.md): who did what to organizations, computers and agents, sign-in attempts, and the
/// platform starting and stopping. Kept a year (at most 200,000 events); never edited.
model AuditEvent {
  sequence   Int      @id @default(autoincrement())
  /// Millisecond precision.
  at         DateTime @default(now())
  /// e.g. auth.login, agent.create, agent.update, computer.delete, organization.create, system.start
  kind       String
  /// ok, failed or denied
  outcome    String
  /// The signed-in person, the name tried at sign-in, or "system".
  actor      String?
  ip         String?
  targetId   String?
  targetName String?
  /// JSON: changed field names, a reason, … never values of secrets.
  detail     String?

  @@index([at])
  @@index([kind, sequence])
}

/// Dashboard samples (docs/dashboard.md): the host's CPU and memory, about once a minute. Kept 14 days.
model SystemSample {
  sequence   Int      @id @default(autoincrement())
  at         DateTime @default(now())
  cpuPercent Float
  memUsed    BigInt
  memTotal   BigInt
  /// Bytes per second over the minute across the physical network interfaces, in and out (null: unknown).
  netRx      Float?
  netTx      Float?

  @@index([at])
}

/// One physical disk's throughput over a minute (bytes per second), from /proc/diskstats. Kept 14 days.
model DiskIoSample {
  sequence Int      @id @default(autoincrement())
  at       DateTime @default(now())
  /// The whole-disk device name (nvme0n1, sda, …).
  device   String
  read     Float
  write    Float

  @@index([at])
  @@index([device, at])
}

/// One physical storage device the platform uses (or an operator-listed one), sampled every few minutes. `disk` is a
/// stable key (the filesystem source, e.g. /dev/nvme0n1p2 or a ZFS pool); `uses` says what lives there.
model DiskSample {
  sequence Int      @id @default(autoincrement())
  at       DateTime @default(now())
  disk     String
  label    String
  /// JSON array: "docker", "platform data", "computer keep", "computer cache", "listed"
  uses     String
  used     BigInt
  total    BigInt

  @@index([at])
  @@index([disk, at])
}

/// A running computer's CPU and memory, about once a minute.
model ComputerSample {
  sequence   Int      @id @default(autoincrement())
  at         DateTime @default(now())
  computerId String
  cpuPercent Float
  memUsed    BigInt
  memLimit   BigInt?
  /// memUsed as a share of the limit at that moment (null without a limit), so a later limit change keeps history.
  memPercent Float?

  @@index([at])
  @@index([computerId, at])
}

/// One model call's tokens and cost, whatever made it (a turn, triage, a watcher, sleep, compaction).
model UsageEvent {
  sequence   Int      @id @default(autoincrement())
  at         DateTime @default(now())
  agentId    String
  /// The provider as Pi names it (openai-codex, openrouter, …) and the endpoint it went through, if any.
  provider   String
  endpointId String?
  model      String
  /// turn, heartbeat, triage, watch, sleep, compaction, discord, other
  purpose    String
  input      Int
  output     Int
  cacheRead  Int
  cacheWrite Int
  reasoning  Int
  /// US dollars as Pi prices it (a subscription's API-equivalent price).
  cost       Float
  /// Backfilled rows point at their session entry, so a backfill never counts one twice.
  sourceKey  String?  @unique

  @@index([at])
  @@index([agentId, at])
}

/// A stretch of time an agent was working (one run), for active hours.
model AgentRunSpan {
  sequence  Int       @id @default(autoincrement())
  agentId   String
  runId     String    @unique
  startedAt DateTime
  endedAt   DateTime?

  @@index([agentId, startedAt])
  @@index([startedAt])
}

/// A known client address or range (docs/login.md): a label shown in the audit log, and whether it is trusted (it
/// may sign in during a lockdown).
model KnownAddress {
  sequence  Int      @id @default(autoincrement())
  id        String   @unique @default(uuid())
  /// An IP address or a CIDR range (100.64.0.0/10, 2001:db8::/32), normalized.
  address   String   @unique
  label     String
  trusted   Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Present while the dashboard is locked down: only trusted addresses may sign in until it is lifted.
model Lockdown {
  id       Int      @id @default(1)
  since    DateTime @default(now())
  /// Failed sign-ins in the hour that triggered it.
  failures Int
}

/// A critical event shown as a banner until dismissed (docs/dashboard.md#critical-events): a possible power outage or
/// crash, a burst of failed sign-ins. Ongoing conditions (a lockdown, a full disk) are not stored: they show while true.
model Alert {
  sequence    Int       @id @default(autoincrement())
  id          String    @unique @default(uuid())
  /// outage, signin-failures
  kind        String
  title       String
  detail      String
  /// The event's own span (an outage: last reading → start-up).
  startedAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dismissedAt DateTime?

  @@index([dismissedAt, createdAt])
}

/// The access log (docs/access-log.md), separate from the audit log: requests folded per minute, so a flood stays
/// a few rows. Kept 30 days.
model AccessMinute {
  sequence Int    @id @default(autoincrement())
  /// Minutes since 1970 (UTC).
  minute   Int
  ip       String
  /// Two-letter country from Cloudflare, or LAN / Tailnet / Local / ?? for the rest.
  country  String
  /// The signed-in person, or "" when none.
  user     String
  method   String
  /// The route pattern (/api/agents/:id), or the raw path (at most 80 characters) when nothing matched.
  route    String
  status   Int
  count    Int
  totalMs  Int
  maxMs    Int

  @@unique([minute, ip, user, method, route, status])
  @@index([minute])
  @@index([ip, minute])
}

/// A device that receives Web Push notifications for a person (docs/notifications.md). The endpoint is a capability
/// URL at the browser's push service; with p256dh/auth it is secret-ish and never returned or logged.
model PushSubscription {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The browser session that subscribed it: signing out, a password change or reset, disabling or deleting the
  /// person ends the session and with it this device's pushes. Null only without sign-in (tests).
  sessionId     String?
  session       UserSession? @relation(fields: [sessionId], references: [tokenHash], onDelete: Cascade)
  endpoint      String       @unique
  p256dh        String
  auth          String
  /// Browser and device from its user agent ("Chrome on Android").
  label         String
  createdAt     DateTime     @default(now())
  lastSuccessAt DateTime?
  /// Failed deliveries in a row (other than expiry, which deletes it); reset by a success.
  failures      Int          @default(0)

  @@index([userId])
  @@index([sessionId])
}

/// What a person is notified about (docs/notifications.md#settings). No row: everything on.
model PushPreferences {
  userId        String  @id
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentMessages Boolean @default(true)
  groupChats    Boolean @default(true)
  agentProblems Boolean @default(true)
  /// Admin only: lockdown, failed sign-ins, outages, full disks.
  critical      Boolean @default(true)
  /// Off: message notifications say "New message" instead of the text.
  preview       Boolean @default(true)
  /// The Swarm itself: updated to a new version, started, stopping.
  swarmUpdates  Boolean @default(true)
  swarmStarts   Boolean @default(true)
  swarmStops    Boolean @default(true)
}

/// An agent's avatar drawn as a PNG by the dashboard, for notification icons (docs/notifications.md#icons).
model AgentAvatarImage {
  agentId   String   @id
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  png       Bytes
  /// The saved avatar (JSON) it was drawn from: a different one means it needs drawing again.
  source    String
  updatedAt DateTime @updatedAt
}
