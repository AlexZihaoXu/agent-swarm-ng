# Optional stage-2 Tailnet HTTPS deployment on the SAME dashboard TCP port.
# The cert/key are provisioned by the operator under .local/ and mounted
# read-only by compose.tailscale-https.yaml, never served to the browser.
{
	servers {
		# Requests may arrive through a reverse proxy on the LAN or tailnet (for example Nginx Proxy Manager behind
		# Cloudflare): trust its forwarded client address so sign-in limits apply per visitor (docs/login.md). A device
		# in these ranges could claim another address; that only changes which sign-in limit it counts against and the
		# address in the audit log.
		trusted_proxies static private_ranges 100.64.0.0/10
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		trusted_proxies_strict
	}
}

{$SITE_ADDRESS} {
	tls /etc/caddy/tailnet.crt /etc/caddy/tailnet.key
	encode zstd gzip

	import /etc/caddy/ComputerRoutes

	handle {
		# Baseline CSP for the application pages only (this replaces the site-wide frame-ancestors-only header, so it repeats it).
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob: data:; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		root * /srv
		@updates path / /sw.js /index.html /manifest.webmanifest
		header @updates Cache-Control "no-cache"
		# Built assets carry a content hash in their names and never change: browsers keep them. Only files that exist
		# (a missing old chunk falls back to index.html, which must not be cached).
		@hashed {
			path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(?:js|css|woff2?|png|svg|webp)$
			file
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
