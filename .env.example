# Safe local defaults. Authentication is not implemented; do not expose publicly.
SITE_ADDRESS=localhost
BIND_ADDRESS=127.0.0.1
# Optional compose.lan-http.yaml: choose a trusted private-LAN host IPv4,
# never 0.0.0.0 or public without an explicit access policy (no app auth).
# LAN_IP=192.168.0.167
# Operator opt-in for GPU-backed managed computers on a host validated for this
# exact render node. Grants the guest access to the host GPU driver/kernel;
# changing it for an existing computer requires a volume-preserving migration.
# COMPUTER_RENDER_DEVICE=/dev/dri/renderD128
# Default per-computer CPU quota (1–8). The creation UI offers host-bounded
# choices up to the controller's policy cap of 8; this setting is the default,
# not the maximum. The Xorg 120-Hz overlay defaults to 4 on this host.
# COMPUTER_CPU_LIMIT=4
# Desktop memory defaults to 4 GiB RAM on this host; the create/edit dialogs
# offer host-bounded per-computer choices (policy cap 16 GiB). Docker gets an
# equal-size host swap allowance, not user volumes. No global memory env setting
# exists; see docs/computers.md.
# Guest desktop clock zone: an IANA name such as America/Toronto. It is never
# inherited from the host, and empty leaves computers at the image default.
# Changing it applies to newly created computers; existing ones keep their zone.
# COMPUTER_TIMEZONE=America/Toronto
# Optional SQLite override; use a container path under /app/.local for Compose.
# DATABASE_URL=file:/absolute/path/platform.db
# Optional run deadline in milliseconds for work the human starts; 0 keeps accepted work running until it finishes or is stopped.
# Work started by another agent (agent DMs, agent replies in groups) always keeps a 90 s safety deadline.
AGENT_RUN_TIMEOUT_MS=0
# Host names, besides IP addresses and localhost, that may reach the API (comma-separated). Besides the sign-in, any
# other name is refused to block DNS rebinding. Set your MagicDNS/DNS name here if you browse by name, for example:
# ALLOWED_HOSTS=my-machine.my-tailnet.ts.net,my-machine
ALLOWED_HOSTS=
# Required: shared secret between the backend and the internal computer controller (which holds the Docker socket).
# Compose refuses to start without it, and the controller answers only its health check. Generate one with
#   openssl rand -hex 32
COMPUTER_CONTROLLER_TOKEN=
# Days of operator activity history to keep; older entries are removed and a marker says so. 0 keeps everything.
ACTIVITY_RETENTION_DAYS=30
# Daily copies of the platform database kept in .local/backups/database; 0 turns them off.
DATABASE_BACKUPS=7
# Build the dashboard without the desktop viewer (no desktop image needed): COMPUTER_VIEWER=off
COMPUTER_VIEWER=on
