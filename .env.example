# Safe local defaults. Authentication is not implemented; do not expose publicly.
SITE_ADDRESS=localhost
BIND_ADDRESS=127.0.0.1
# Optional SQLite override; use a container path under /app/.local for Compose.
# DATABASE_URL=file:/absolute/path/platform.db
# Optional run deadline in milliseconds; 0 keeps accepted work running until it finishes or is stopped.
AGENT_RUN_TIMEOUT_MS=0
